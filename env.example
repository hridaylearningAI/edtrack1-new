# EdTec Student Management System Frontend Environment Variables

# ============================================
# Clerk Authentication (Required)
# ============================================
# Get your keys from: https://dashboard.clerk.com
# IMPORTANT: Must use the SAME Clerk application as the portfolio app!
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Redirect URLs (for cross-app authentication)
# FALLBACK_REDIRECT_URL is used if no redirect_url parameter is present
# Users will be redirected to home page, which then redirects based on role
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Demo Platform Overview (/demo → /platform map)
# Create this user in Clerk Dashboard with publicMetadata.role = "admin"
# so SMS from the map can open live /admin data.
NEXT_PUBLIC_DEMO_PLATFORM_EMAIL=demo@edtec.edu.au
# Password is set in Clerk (not stored in this file). Sign in at /demo.
# Demo login uses /api/auth/demo-sign-in (sign-in ticket) so no email OTP inbox is required.

# ============================================
# Supabase Configuration (Required)
# ============================================
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here

# ============================================
# Cross-App Configuration
# ============================================
# Portfolio App URL (for cross-app authentication)
NEXT_PUBLIC_PORTFOLIO_URL=https://edtec.online

# H5P / course content base URL (CDN in front of S3 bucket - preferred)
# Fallback direct S3: https://edtec-online-h5p-content.s3.us-east-1.amazonaws.com/test
NEXT_PUBLIC_H5P_CONTENT_BASE_URL=https://d1yyshitp0zb6s.cloudfront.net/test

# ============================================
# Optional: Stripe & Resend
# ============================================
# STRIPE_SECRET_KEY=sk_test_...
# VITE_STRIPE_PUBLISHABLE_KEY or NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... (for certificate upgrade payments)
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@edtec.online
# EMAIL_LOGO_URL=https://edtec.online/etia-logo.png

# Optional: Microsoft Teams (automatic meeting link generation)
# Requires Graph app + admin consent + application access policy.
# GRAPH_TENANT_ID=your_directory_tenant_id
# GRAPH_CLIENT_ID=your_app_registration_application_client_id
# GRAPH_CLIENT_SECRET=the_secret_VALUE_shown_only_once_when_you_add_a_secret
#   If you see AADSTS7000215: you pasted the secret ID (UUID label in the list), not the Value.
#   Create a new client secret, copy the Value immediately (long string), not the Secret ID column.
# GRAPH_ORGANIZER_USER_OBJECT_ID=object_id_of_a_real_user_in_entra_who_will_host_meetings
#   (Entra admin center → Users → open user → copy "Object ID" — NOT the client secret, NOT application ID)

# ============================================
# Development Configuration
# ============================================
NODE_ENV=development
